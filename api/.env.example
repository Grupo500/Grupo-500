# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# NextAuth (mismo secret que el frontend)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# URL pública de esta API (Railway la inyecta como RAILWAY_PUBLIC_DOMAIN automáticamente)
# Solo necesitas definir API_URL si el dominio no se detecta solo
# API_URL=https://api-production-79572.up.railway.app

# Typeform
TYPEFORM_API_KEY=...

# Twilio WhatsApp (futuro)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Gastos de agencia (Finanzas > Gastos de agencia)
# Identificador del Google Sheet de contabilidad interna. Va por entorno y NO en
# el código: este repositorio es público y el sheet trae cédulas y cuentas.
# Sin esta variable el panel responde 503 y avisa que falta configurarlo.
GASTOS_AGENCIA_SHEET_ID=
# Opcionales, solo si cambian los gid de las pestañas del sheet
# GASTOS_AGENCIA_GID_NOMINA=0
# GASTOS_AGENCIA_GID_ACTUAL=1489175693
# GASTOS_AGENCIA_GID_PREVIO=1461721508
# GASTOS_AGENCIA_GID_CUENTAS=58985148

# Logging
LOG_LEVEL=info

# Encryption (para datos sensibles)
ENCRYPTION_KEY=una-clave-de-32-chars-minimo-aqui
