generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                @id @default(cuid())
  email                  String                @unique
  role                   Role                  @default(VENDEDOR)
  // Cuenta suspendida: no puede entrar a la plataforma (web ni API) pero no
  // se borra nada — para gente que ya no trabaja aquí sin perder su registro.
  // La levanta un admin desde Usuarios. Distinto de Asesor.activo: retirar
  // saca del ranking y purga a los 60 días; suspender solo corta el acceso.
  suspendido             Boolean               @default(false)
  suspendidoEn           DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  image                  String?
  nombre                 String?
  emailVerified          DateTime?
  hashedPassword         String?
  accounts               Account[]
  asesor                 Asesor?
  marketing              MiembroMarketing?
  passkeys               Passkey[]
  sessions               Session[]
  correcciones           CorreccionContenido[]
  pushSubs               PushSubscription[]
  apiKeys                ApiKey[]
  notificaciones         Notificacion[]        @relation("DestinatarioNotificacion")
  notificacionesQueCauso Notificacion[]        @relation("AutorNotificacion")
  apuntes                Apunte[]
  apuntesCompartidos     ApunteCompartido[]
}

/// El bloc de notas de cada quien en Marketing (Hotman, 22-ago). Privado por
/// defecto: lo ve solo su dueño y con quien él lo comparta.
model Apunte {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titulo      String    @default("")
  /// El HTML del editor (negritas, listas, tareas...), limpiado en el servidor.
  contenido   String    @default("") @db.Text
  /// Etiqueta libre ("Pendientes", "Ideas"...) y su color, para agrupar.
  etiqueta    String?
  color       String?
  fijado      Boolean   @default(false)
  archivadoEn DateTime?
  /// Papelera: se recupera durante 30 días, después se purga.
  eliminadoEn DateTime?
  compartidos ApunteCompartido[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@map("marketing_apuntes")
}

model ApunteCompartido {
  id          String   @id @default(cuid())
  apunteId    String
  apunte      Apunte   @relation(fields: [apunteId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puedeEditar Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([apunteId, userId])
  @@map("marketing_apuntes_compartidos")
}

/// Qué provocó el aviso. Define el icono y el color con que se lee en la
/// bandeja antes que el texto: azul te encargaron algo, rojo hay que rehacer,
/// verde algo salió bien.
enum TipoNotificacion {
  TAREA_ASIGNADA
  CAMBIOS_PEDIDOS
  CORRECCION_HECHA
  TAREA_PUBLICADA
}

/// Un aviso guardado dentro de la app.
///
/// Hasta ahora los avisos salían solo como notificación del navegador: si la
/// persona no había dado permiso, o tenía el equipo apagado, no se enteraba
/// nunca de que le habían asignado un trabajo (Hotman, 20-ago). El push sigue
/// existiendo como refuerzo; esto es lo que queda.
model Notificacion {
  id          String           @id @default(cuid())
  /// A quién le llega.
  userId      String
  usuario     User             @relation("DestinatarioNotificacion", fields: [userId], references: [id], onDelete: Cascade)
  /// Quién lo provocó, para poner su foto al lado. Null si fue el sistema.
  autorId     String?
  autor       User?            @relation("AutorNotificacion", fields: [autorId], references: [id], onDelete: SetNull)
  tipo        TipoNotificacion
  /// Ya redactado al guardarlo: reconstruirlo después obligaría a conservar
  /// vivos el contenido y las personas que menciona.
  texto       String
  /// A dónde lleva al pulsarlo.
  url         String
  /// La tarea de la que habla, para abrirla directamente. Sin relación formal:
  /// el aviso sobrevive a que la tarea se borre.
  contenidoId String?
  leidaEn     DateTime?
  createdAt   DateTime         @default(now())

  @@index([userId, leidaEn])
  @@index([userId, createdAt])
  @@map("notificaciones")
}

model ApiKey {
  id          String    @id @default(cuid())
  nombre      String
  keyHash     String    @unique
  prefijo     String
  scopes      String[]
  activa      Boolean   @default(true)
  ultimoUso   DateTime?
  creadaPorId String
  creadaPor   User      @relation(fields: [creadaPorId], references: [id])
  createdAt   DateTime  @default(now())
  revocadaAt  DateTime?
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String
  backedUp     Boolean   @default(false)
  transports   String[]
  name         String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Asesor {
  id                   String             @id @default(cuid())
  userId               String             @unique
  nombre               String
  email                String
  // Correo alterno de solo lectura para cruzar leads de Trengo/HubSpot cuando
  // el asesor inició sesión ahí con un correo distinto al de su perfil (ej.
  // Sara Duarte: perfil saraduarte5500@gmail.com, Trengo funnyplayer407@gmail.com).
  // Campo interno — no se expone en ningún formulario, se asigna a mano por caso.
  emailCrm             String?
  telefono             String
  // Códigos de rastreo Hotmart (src/sck de sus links) + email de afiliado
  codigosHotmart       String[]           @default([])
  // Snapshot del ranking para detectar rebases entre ventas (notificaciones push)
  posicionRanking      Int?
  posicionMes          String?
  /// Comisión sobre pagos que entran POR FUERA de Hotmart (Nequi, transferencia,
  /// efectivo), como fracción: 0.03 = 3%. Los pagos de Hotmart no la usan — su
  /// reparto lo decide Hotmart y la app solo lo lee. Es por asesor porque la
  /// tarifa se negocia individualmente (Cielo Guevara pasó a 9% en ago-2026).
  comisionDirecta      Float              @default(0.03)
  /// Desde cuándo rige `comisionDirecta`. Una tarifa negociada arranca un día,
  /// no rige hacia atrás: los pagos anteriores a esta fecha se liquidan al 3%
  /// estándar. Vacío = la tarifa aplica a todo su historial.
  comisionDirectaDesde DateTime?
  /// Cuenta de operación (administración, soporte, la cuenta productora de
  /// Hotmart), no de alguien que vende. Existe como Asesor porque el resto de
  /// la app cuelga de ahí, pero queda fuera del ranking: sin ventas nunca,
  /// solo aportaba filas en cero al final de la tabla.
  ///
  /// Es una marca propia y no `role = ADMIN` porque son cosas distintas —
  /// Soporte G500 es VENDEDOR y tampoco vende, y un día puede haber un
  /// administrador que sí venda y deba aparecer.
  esAdministrativo     Boolean            @default(false)
  // Retirado del equipo (activo=false): desaparece del ranking y de los
  // selectores, pero se CONSERVA 60 días por si vuelve (decisión de Hotman,
  // 18-ago-2026). Cumplidos los 60 días desde retiradoEn, el job
  // purgarAsesoresRetirados lo borra del todo; sus pagos quedan sin asesor
  // (los totales históricos no cambian, la atribución individual sí se pierde).
  activo               Boolean            @default(true)
  retiradoEn           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  estudiantes          Estudiante[]
  negociaciones        Negociacion[]
  pagos                Pago[]
  alias                AliasAsesor[]
  afiliaciones         AfiliacionAsesor[]
}

model Colegio {
  id                String             @id @default(cuid())
  nombre            String             @unique
  ciudad            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contactoNombre    String?
  contactoEmail     String?
  contactoTelefono  String?
  estudiantes       Estudiante[]
  negociaciones     Negociacion[]
  estudiantesExamen EstudianteExamen[]
}

model Estudiante {
  id                 String                @id @default(cuid())
  nombre             String
  email              String
  telefono           String
  fechaNacimiento    DateTime
  colegioId          String?
  asesorId           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  ciudad             String?
  departamento       String?
  documento          String?
  tipoDocumento      String?               @default("TI")
  carreraInteres     String?
  grado              String?
  interesPremedico   String?
  primerIcfes        Boolean?              @default(true)
  puntajeAnterior    String?
  universidadInteres String?
  lineaAutorizada    Int?
  agregado           Boolean               @default(false)
  nombreGrupo        String?
  documentoUrl       String?
  direccion          String?
  verificado         Boolean               @default(false)
  verificadoPor      String?
  verificadoAt       DateTime?
  acudiente          Acudiente?
  certificados       Certificado[]
  cursos             CursoEstudiante[]
  asesor             Asesor?               @relation(fields: [asesorId], references: [id])
  colegio            Colegio?              @relation(fields: [colegioId], references: [id])
  fuenteContacto     FuenteContacto?
  historial          HistorialEstudiante[]
  observaciones      Observacion[]
  pagos              Pago[]
  simulacros         SimulacroEstudiante[]
  cuotasAtrasadas    CuotaAtrasada[]
}

/// Cuota de un plan de Hotmart cuyo cobro falló y sigue sin pagarse.
///
/// Antes el atraso se ESTIMABA (30 días de ciclo + 7 de gracia desde el último
/// cobro conocido). Hotmart sabe cuál cobro falló de verdad y lo expone en su
/// API (`transaction_status=OVERDUE`), que es lo que alimenta esta tabla.
///
/// Es una foto que refresca `sincronizarAtrasos.ts`, no una consulta en vivo:
/// resolverlo en cada carga de pantalla exigiría recorrer miles de ventas de
/// la API de Hotmart. Que sea una tabla también significa que un fallo de la
/// API deja en pie el último dato bueno en vez de vaciar la lista.
///
/// Solo entran los atrasos VIVOS. De 99 cuotas que Hotmart reportó vencidas,
/// solo 34 lo estaban de verdad: 32 ya las había recobrado Hotmart en un
/// reintento, 30 eran reintentos fallidos duplicados de la misma cuota y 3 se
/// habían pagado por fuera (Nequi/transferencia), algo de lo que Hotmart nunca
/// se entera. Sin esos filtros, dos de cada tres avisos serían para alguien
/// que no debe nada.
model CuotaAtrasada {
  id              String      @id @default(cuid())
  /// Transacción del cobro fallido en Hotmart: identifica el atraso y evita duplicados.
  transaccion     String      @unique
  estudianteId    String?
  estudiante      Estudiante? @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  /// Se guardan aunque haya estudiante: si el comprador no está en la base
  /// todavía, el atraso igual queda visible para que alguien lo gestione.
  emailComprador  String
  nombreComprador String
  productoId      String
  productoNombre  String
  cuotaNumero     Int
  cuotasTotal     Int
  monto           Int
  /// Cuándo Hotmart intentó cobrar esta cuota.
  fechaCobro      DateTime
  sincronizadoEn  DateTime    @updatedAt

  @@index([estudianteId])
  @@map("cuotas_atrasadas")
}

model HistorialEstudiante {
  id           String     @id @default(cuid())
  estudianteId String
  accion       String
  descripcion  String
  cambios      Json?
  realizadoPor String
  userId       String
  createdAt    DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model Observacion {
  id           String     @id @default(cuid())
  estudianteId String
  texto        String
  autor        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model Acudiente {
  id              String     @id @default(cuid())
  nombre          String
  email           String?
  telefono        String
  relacion        String
  estudianteId    String     @unique
  numeroDocumento String?
  tipoDocumento   String?
  estudiante      Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model FuenteContacto {
  id           String     @id @default(cuid())
  estudianteId String     @unique
  fuente       String
  formId       String?
  respondedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  estudiante   Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model Curso {
  id               String             @id @default(cuid())
  nombre           String
  descripcion      String?
  precio           Float
  duracionHoras    Int
  activo           Boolean            @default(true)
  tipoCurso        TipoCurso          @default(INDIVIDUAL)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  calendario       CalendarioCurso    @default(A)
  fechaFin         DateTime?
  fechaInicio      DateTime?
  fechaIcfes       DateTime?
  simulacros       Int?
  visibleEnLanding Boolean            @default(false)
  cuposDisponibles Int?
  hotmartProductId String?            @unique
  // Línea de producto para agrupar en reportes (Intensivo, Calendario, Combo,
  // Año 500, Premédico, Ruta 500). Se siembra desde el nombre pero es editable:
  // deducirla del texto en cada consulta rompería al renombrar un curso.
  familia          String?
  // Link para que un asesor se afilie a este producto en Hotmart. No hay API
  // de Hotmart para armarlo ni para saber quién ya está afiliado (confirmado
  // con su soporte) — un admin lo copia una vez desde Hotmart y cada asesor
  // marca su propio estado (ver AfiliacionAsesor).
  linkAfiliacion   String?
  // Usados en el certificado (CertificadoTemplate.tsx): antes el texto de
  // materias/horario estaba escrito fijo en el PDF, igual para todos los
  // cursos. horarioTexto es libre porque algunos cursos (ej. Ruta 500) no
  // son una franja semanal fija — mezclan sábados recurrentes con viernes o
  // domingos puntuales que no entran en una grilla día/hora.
  materias         String[]           @default([])
  horarioTexto     String?
  estudiantes      CursoEstudiante[]
  preciosOficiales PrecioOficial[]
  afiliaciones     AfiliacionAsesor[]
}

// Un asesor marca a mano que ya se afilió a un producto en Hotmart — no hay
// forma de leerlo automáticamente (ver comentario en Curso.linkAfiliacion).
model AfiliacionAsesor {
  id        String   @id @default(cuid())
  asesorId  String
  cursoId   String
  marcadoEn DateTime @default(now())

  asesor Asesor @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  curso  Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([asesorId, cursoId])
  @@map("ventas_afiliaciones_asesor")
}

model Formulario {
  id               String   @id @default(cuid())
  nombre           String
  descripcion      String?
  campos           Json // FieldSchema[]
  meta             Json? // { colorPrimario, mensajeBienvenida, mensajeExito, icono }
  activo           Boolean  @default(false)
  visibleEnLanding Boolean  @default(false)
  cursoId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CursoEstudiante {
  id                  String     @id @default(cuid())
  estudianteId        String
  cursoId             String
  fechaCompra         DateTime   @default(now())
  descuentoPorcentaje Float      @default(0)
  // Total real acordado con este estudiante (precio Hotmart con descuento).
  // Si es null, se usa el precio de lista del curso.
  precioAcordado      Float?
  curso               Curso      @relation(fields: [cursoId], references: [id])
  estudiante          Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, cursoId])
}

model Pago {
  id               String     @id @default(cuid())
  estudianteId     String
  asesorId         String?
  monto            Float
  estado           EstadoPago @default(PENDIENTE)
  metodo           String
  fechaVencimiento DateTime
  fechaPago        DateTime?
  comprobante      String?
  referenciaPago   String?
  comprobanteAt    DateTime?
  notas            String?
  // Desglose de comisiones (en COP, convertido desde USD con TRM oficial de la fecha)
  comisionHotmart  Float? // comisión de la plataforma Hotmart (fee + addon)
  comisionAsesor   Float? // comisión del afiliado/asesor
  montoNeto        Float? // neto que recibe el productor
  trm              Float? // TRM oficial usada para la conversión
  // Pagos en partes de Hotmart (Smart Installment): el cargo que llega es una
  // cuota, no el precio del curso. Datos tal como los reporta Hotmart.
  enPartes         Boolean    @default(false) // offer.payment_mode = MULTIPLE_PAYMENTS
  cuotaNumero      Int? // purchase.recurrency_number — qué cuota es este cargo
  cuotasTotal      Int? // purchase.payment.installments_number
  // Cupón aplicado en la compra, si lo hubo. Hotmart no lo enviaba a la app
  // y por eso el indicador de ventas con descuento no existía.
  cupon            String?
  // Nombre del afiliado tal como llega de Hotmart. Se guarda aunque no se
  // logre vincular al asesor: sin él no hay forma de homologarlo después.
  afiliadoHotmart  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  asesor           Asesor?    @relation(fields: [asesorId], references: [id])
  estudiante       Estudiante @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

// Registro crudo de los postbacks de Hotmart. Sin esto no hay forma de saber
// qué mandó realmente la plataforma cuando algo no cuadra — fue justo lo que
// impidió diagnosticar por qué las ventas a cuotas no se detectaban.
model HotmartWebhookLog {
  id          String   @id @default(cuid())
  evento      String?
  transaccion String?
  payload     Json
  createdAt   DateTime @default(now())

  @@index([transaccion])
  @@index([createdAt])
  @@map("hotmart_webhook_logs")
}

model Certificado {
  id           String          @id @default(cuid())
  estudianteId String
  tipo         TipoCertificado
  archivoUrl   String
  numeroSerie  String          @unique
  fechaEmision DateTime        @default(now())
  expiracion   DateTime?
  estudiante   Estudiante      @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
}

model Simulacro {
  id          String                @id @default(cuid())
  nombre      String
  archivoUrl  String
  tipoArchivo String                @default("pdf")
  procesado   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  estudiantes SimulacroEstudiante[]
}

model SimulacroEstudiante {
  id                 String                @id @default(cuid())
  estudianteId       String
  simulacroId        String
  puntajeTotal       Int
  porcentajeAciertos Float
  areasDebiles       String[]
  rendimiento        RendimientoEstudiante
  requiereIntensivo  Boolean               @default(false)
  fechaAnalisis      DateTime              @default(now())
  estudiante         Estudiante            @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  simulacro          Simulacro             @relation(fields: [simulacroId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, simulacroId])
}

model ConfigApp {
  id        String   @id @default(cuid())
  clave     String   @unique
  valor     String
  updatedAt DateTime @updatedAt
}

model Negociacion {
  id                String           @id @default(cuid())
  colegioId         String
  asesorId          String
  etapa             EtapaNegociacion @default(PROSPECTO)
  notas             String?
  fechaContacto     DateTime?
  fechaReunion      DateTime?
  fechaProxContacto DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  asesor            Asesor           @relation(fields: [asesorId], references: [id])
  colegio           Colegio          @relation(fields: [colegioId], references: [id], onDelete: Cascade)
}

// ── Marketing: planificación de contenido, guiones y entregables publicados ──
model MiembroMarketing {
  id               String  @id @default(cuid())
  userId           String  @unique
  nombre           String
  activo           Boolean @default(true)
  // ── Datos para la cuenta de cobro ──────────────────────────────────────
  //
  // Son los seis datos que antes se escribían cada vez en el formulario de la
  // landing y que nunca cambian de un mes a otro. Guardados aquí, el PDF se
  // arma solo cuando se aprueba el cobro: lo que falta —fecha, periodo,
  // concepto y valor— ya lo tiene el propio ContenidoMarketing.
  //
  // Todos opcionales: la cuenta se crea antes de que la persona entre a
  // llenarlos, y quien no los tenga sale marcado en Cobros.
  nombreCompleto   String?
  cedula           String?
  ciudadExpedicion String?
  ciudad           String?
  celular          String?
  rut              String?
  banco            String?
  tipoCuenta       String? // AHORROS | CORRIENTE
  numeroCuenta     String?
  // La rúbrica dibujada, en Cloudinary. Se incrusta sobre la línea del PDF.
  firmaUrl         String?

  createdAt DateTime @default(now())

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  asignados ContenidoMarketing[] @relation("AsignadoA")
  aprobados ContenidoMarketing[] @relation("AprobadoPor")

  @@map("marketing_miembros")
}

enum TipoContenidoMarketing {
  VIDEO // se muestra como "Reel" en la UI — se conserva el nombre para no romper contenidos ya guardados
  VSL
  CARRUSEL
  CARRUMEME
  TIKTOKERO
  GUION
  PUBLICACION
  OTRO
  HISTORIA // historias de IG/FB: otra modalidad de trabajo (Hotman, 22-ago)
}

enum EstadoContenidoMarketing {
  PLANIFICADO
  EN_PROCESO
  PUBLICADO
}

enum DestinoContenido {
  SEBASTIAN_PERSONAL
  ANDRES_PERSONAL
  PREICFES
  PREMEDICO
}

enum ClasificacionContenido {
  ORGANICO
  PAUTA
}

/// Quién hace el trabajo. La distinción existe porque el freelance se cobra:
/// es la única pieza de contenido que lleva un valor asociado.
enum TipoTrabajoMarketing {
  EMPRESA
  FREELANCE
}

/// Ciclo de vida del cobro de un freelance. Solo aplica cuando el trabajo es
/// FREELANCE; en los de empresa no hay nada que aprobar ni que pagar.
enum EstadoCobroMarketing {
  POR_APROBAR
  APROBADO
  PAGADO
}

/// Una ronda de correcciones sobre un trabajo.
///
/// Reemplaza lo que el equipo hacía en Trello (decisión de Hotman, 20-ago):
/// quien revisa escribe qué hay que arreglar, le llega a quien lo hizo, y la
/// tarea queda marcada hasta que se corrija. Se guardan TODAS las rondas y no
/// solo la última: si un video va por la tercera corrección, eso se tiene que
/// poder ver.
model CorreccionContenido {
  id          String             @id @default(cuid())
  contenidoId String
  contenido   ContenidoMarketing @relation(fields: [contenidoId], references: [id], onDelete: Cascade)
  mensaje     String
  /// Quién las pidió. Va contra User y no contra MiembroMarketing porque un
  /// administrador puede pedir cambios sin tener ficha de marketing.
  pedidaPorId String
  pedidaPor   User               @relation(fields: [pedidaPorId], references: [id])
  /// Cuándo quien lo hizo marcó que ya corrigió. Null = todavía pendiente.
  resueltaEn  DateTime?
  createdAt   DateTime           @default(now())

  @@index([contenidoId])
  @@map("marketing_correcciones")
}

model ContenidoMarketing {
  id             String                 @id @default(cuid())
  titulo         String
  correcciones   CorreccionContenido[]
  /// Quién repartió este trabajo (userId). Sin esto, un community manager no
  /// puede ver lo que él mismo asignó: el trabajo queda a nombre del editor y
  /// se pierde el rastro de quién lo encargó y debe revisarlo.
  asignadoPorId  String?
  tipo           TipoContenidoMarketing
  destino        DestinoContenido?
  clasificacion  ClasificacionContenido @default(ORGANICO)
  /// EMPRESA por defecto: la mayor parte del contenido lo hace el equipo de
  /// planta y no se cobra aparte.
  tipoTrabajo    TipoTrabajoMarketing   @default(EMPRESA)
  /// Lo que se cobra por el trabajo, en pesos y sin centavos. Solo tiene
  /// sentido en los freelance — en los de empresa se guarda null, para que no
  /// queden importes colgando de trabajo interno.
  valor          Int?
  /// En qué va el cobro. Arranca POR_APROBAR en cuanto el trabajo se marca
  /// como freelance, aunque todavía no se haya entregado: el freelance debe
  /// poder esperar aprobación desde que se le encarga.
  estadoCobro    EstadoCobroMarketing   @default(POR_APROBAR)
  /// Quién dio el visto bueno y cuándo. En algo que mueve plata, la firma
  /// importa tanto como el monto — sin esto no hay a quién preguntarle.
  // La cuenta de cobro en PDF, una vez generada. Se guarda el enlace y no el
  // archivo: vive en Drive, que es donde contabilidad ya las busca.
  cuentaCobroUrl String?
  cuentaCobroEn  DateTime?

  aprobadoPorId String?
  aprobadoEn    DateTime?
  /// Cuándo se pagó de verdad. Separado de la aprobación porque son dos
  /// momentos distintos y a veces los separan semanas.
  pagadoEn      DateTime?
  fecha         DateTime // día planificado en el calendario
  estado        EstadoContenidoMarketing @default(PLANIFICADO)
  notas         String?
  asignadoAId   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  asignadoA   MiembroMarketing? @relation("AsignadoA", fields: [asignadoAId], references: [id])
  aprobadoPor MiembroMarketing? @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  entregables Entregable[]

  @@map("marketing_contenidos")
}

enum PlataformaEntregable {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  DRIVE
  OTRO
}

model Entregable {
  id          String               @id @default(cuid())
  contenidoId String
  plataforma  PlataformaEntregable
  url         String? // link externo (YouTube/IG/TikTok/Drive)
  videoUrl    String? // URL de Cloudinary si se subió el video directo
  publicadoEn DateTime             @default(now())
  createdAt   DateTime             @default(now())

  contenido ContenidoMarketing @relation(fields: [contenidoId], references: [id], onDelete: Cascade)

  @@map("marketing_entregables")
}

enum Role {
  ADMIN
  VENDEDOR
  // Todos los de abajo entran SOLO al área de Marketing: no ven estudiantes,
  // ventas ni finanzas. Se distinguen entre sí por la especialidad y, en el
  // caso de LIDER_EDICION, por lo que puede aprobar.
  MARKETING
  EDITOR // editor de video
  COMMUNITY // community manager
  LIDER_EDICION // líder de editores: ve los cobros de todos y es quien los aprueba
  SOCIAL_MEDIA // social media manager
  LIDER_DISENO // líder de diseño gráfico
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  VENCIDO
  CANCELADO
}

enum TipoCertificado {
  CURSANDO
  COMPLETADO
}

enum RendimientoEstudiante {
  BAJO
  MEDIO
  ALTO
}

enum CalendarioCurso {
  A
  B
}

enum TipoCurso {
  INDIVIDUAL
  COMBO
}

enum EtapaNegociacion {
  PROSPECTO
  CONTACTO
  PROPUESTA
  REUNION
  CONVENIO
  DESCARTADO
}

// Conversaciones de Trengo asignadas a un asesor (= leads).
// El webhook upsertea por ticketId; si cambia el asesor se actualiza el agentEmail
// y se preserva firstAssignedAt para distinguir "lead nuevo" de "reasignación".
model TrengoTicket {
  ticketId        String   @id
  agentEmail      String
  firstAssignedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentEmail])
  @@index([firstAssignedAt])
}

// Leads provenientes de HubSpot: cada Ticket (conversación autoasignada a
// un asesor — chat, email, formulario) cuenta como un lead, igual que
// TrengoTicket. Cruzados por el email del "owner" asignado en HubSpot.
model HubspotLead {
  ticketId         String   @id
  ownerEmail       String
  createdAtHubspot DateTime
  updatedAt        DateTime @updatedAt

  @@index([ownerEmail])
  @@index([createdAtHubspot])
}

// ============================================================
// MÓDULO SIMULACROS (motor de examen online)
// Migrado desde la app simulacros-grupo500 (Supabase → Railway PG).
// Tablas conservan nombre sim_* (@@map) para no chocar con el
// modelo `Simulacro` existente (que es análisis de PDFs, otra cosa).
// Estudiantes de examen = tabla aparte (NO el Estudiante de ventas).
// ============================================================

model Examen {
  id          Int              @id // ids explícitos (1,2,3), no autoincrement
  titulo      String
  descripcion String?
  abreAt      DateTime?        @map("abre_at")
  cierraAt    DateTime?        @map("cierra_at")
  duracionMin Int?             @map("duracion_min")
  activo      Boolean          @default(false)
  preguntas   PreguntaExamen[]
  intentos    IntentoExamen[]
  accesos     AccesoExamen[]

  @@map("sim_simulacros")
}

model PreguntaExamen {
  id             BigInt                 @id @default(autoincrement())
  examenId       Int                    @map("simulacro_id")
  sesion         Int
  area           String?
  numero         Int?
  contexto       String?
  enunciado      String
  opcionA        String?                @map("opcion_a")
  opcionB        String?                @map("opcion_b")
  opcionC        String?                @map("opcion_c")
  opcionD        String?                @map("opcion_d")
  opcionE        String?                @map("opcion_e")
  opcionF        String?                @map("opcion_f")
  opcionG        String?                @map("opcion_g")
  opcionH        String?                @map("opcion_h")
  correcta       String                 @db.Char(1)
  explicacion    String?
  retroOpciones  Json?                  @map("retro_opciones")
  imagenUrl      String?                @map("imagen_url")
  tieneImagen    Boolean                @default(false) @map("tiene_imagen")
  examen         Examen                 @relation(fields: [examenId], references: [id])
  britoLecciones BritoLeccionPregunta[]

  @@index([examenId, sesion, numero])
  @@map("sim_preguntas")
}

model EstudianteExamen {
  id            String          @id @default(uuid()) @db.Uuid
  email         String          @unique
  documentoHash String          @map("documento_hash")
  nombre        String
  tipoDocumento String?         @map("tipo_documento") // CC, TI, CE…
  colegioId     String?         @map("colegio_id")
  creadoAt      DateTime        @default(now()) @map("creado_at")
  colegio       Colegio?        @relation(fields: [colegioId], references: [id])
  intentos      IntentoExamen[]
  accesos       AccesoExamen[]
  britoPerfil   BritoPerfil?

  @@map("sim_estudiantes")
}

/// Acceso diferenciado estudiante↔examen (PRD simulacros §3.1). Un estudiante
/// solo ve y presenta los exámenes con acceso activo. Retirar un producto pone
/// `retiradoAt` (oculta sin borrar; los resultados históricos se conservan).
model AccesoExamen {
  id           String           @id @default(cuid())
  estudianteId String           @map("estudiante_id") @db.Uuid
  examenId     Int              @map("simulacro_id")
  habilitadoAt DateTime         @default(now()) @map("habilitado_at")
  retiradoAt   DateTime?        @map("retirado_at")
  estudiante   EstudianteExamen @relation(fields: [estudianteId], references: [id], onDelete: Cascade)
  examen       Examen           @relation(fields: [examenId], references: [id], onDelete: Cascade)

  @@unique([estudianteId, examenId])
  @@index([examenId])
  @@map("sim_accesos")
}

// ── Brito: modo de práctica gamificado, capa nueva sobre el banco de preguntas
// existente (PreguntaExamen). No toca el motor de simulacros/exámenes real. ──
model BritoLeccion {
  id          String                   @id @default(cuid())
  materia     String
  titulo      String
  orden       Int
  sesion      Int                      @default(1)
  createdAt   DateTime                 @default(now())
  preguntas   BritoLeccionPregunta[]
  completadas BritoLeccionCompletada[]

  @@map("brito_lecciones")
}

model BritoLeccionPregunta {
  leccionId  String
  preguntaId BigInt
  orden      Int
  leccion    BritoLeccion   @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  pregunta   PreguntaExamen @relation(fields: [preguntaId], references: [id])

  @@id([leccionId, preguntaId])
  @@map("brito_leccion_preguntas")
}

model BritoPerfil {
  id               String           @id @default(cuid())
  estudianteId     String           @unique @db.Uuid
  xpTotal          Int              @default(0)
  corazones        Int              @default(5)
  corazonesAt      DateTime         @default(now())
  rachaActual      Int              @default(0)
  rachaMejor       Int              @default(0)
  ultimaLeccionAt  DateTime?
  plan             String           @default("FREE")
  liga             Int              @default(0)
  ligaSemana       String?
  semanasInactivas Int              @default(0)
  quinis           Int              @default(0)
  createdAt        DateTime         @default(now())
  estudiante       EstudianteExamen @relation(fields: [estudianteId], references: [id], onDelete: Cascade)

  @@map("brito_perfiles")
}

model BritoGrupoLiga {
  id        String             @id @default(cuid())
  liga      Int
  semana    String
  createdAt DateTime           @default(now())
  miembros  BritoMiembroLiga[]

  @@index([liga, semana])
  @@map("brito_grupos_liga")
}

model BritoMiembroLiga {
  id           String         @id @default(cuid())
  grupoId      String
  estudianteId String         @db.Uuid
  xpSemana     Int            @default(0)
  resultado    String?
  grupo        BritoGrupoLiga @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, estudianteId])
  @@index([estudianteId])
  @@map("brito_miembros_liga")
}

model BritoLeccionCompletada {
  id           String       @id @default(cuid())
  estudianteId String       @db.Uuid
  leccionId    String
  correctas    Int
  total        Int
  xpGanado     Int
  completadaAt DateTime     @default(now())
  leccion      BritoLeccion @relation(fields: [leccionId], references: [id], onDelete: Cascade)

  @@index([estudianteId, leccionId])
  @@map("brito_lecciones_completadas")
}

model IntentoExamen {
  id                  BigInt           @id @default(autoincrement())
  estudianteId        String           @map("estudiante_id") @db.Uuid
  examenId            Int              @map("simulacro_id")
  respuestas          Json             @default("{}")
  correctas           Int?
  total               Int?
  puntaje             Decimal?         @db.Decimal
  sesionActual        Int              @default(1) @map("sesion_actual")
  iniciadoAt          DateTime         @default(now()) @map("iniciado_at")
  finalizadoAt        DateTime?        @map("finalizado_at")
  sesion1IniciadoEn   DateTime?        @map("sesion1_iniciado_en")
  sesion1ConsumidoSeg Int              @default(0) @map("sesion1_consumido_seg")
  sesion2IniciadoEn   DateTime?        @map("sesion2_iniciado_en")
  sesion2ConsumidoSeg Int              @default(0) @map("sesion2_consumido_seg")
  estudiante          EstudianteExamen @relation(fields: [estudianteId], references: [id])
  examen              Examen           @relation(fields: [examenId], references: [id])

  @@unique([estudianteId, examenId])
  @@map("sim_intentos")
}

// ── Finanzas ────────────────────────────────────────────────────────────────

/// Gasto publicitario por campaña y período.
/// Se carga a mano desde los reportes de cada plataforma; las APIs entran
/// después sin cambiar esta forma. Los reportes de Google y TikTok no traen
/// fechas, por eso el período se guarda aquí en vez de deducirse.
model InversionPublicitaria {
  id           String   @id @default(cuid())
  plataforma   String // GOOGLE | META | TIKTOK
  /// Id de la campaña en la plataforma. Solo lo traen las filas que llegan por
  /// API; las cargadas a mano lo dejan nulo. Es la mitad de la clave que evita
  /// duplicados al re-sincronizar, y aguanta que la campaña cambie de nombre.
  campaniaId   String?
  campania     String
  desde        DateTime
  hasta        DateTime
  gastoCOP     Float
  impresiones  Int      @default(0)
  clics        Int      @default(0)
  /// Conversiones que declara la plataforma. No se usan para el CAC: no hay
  /// atribución real entre el clic y la venta en Hotmart.
  conversiones Int      @default(0)
  estado       String?
  /// MANUAL | API. Distingue lo que tecleó una persona de lo que trajo la
  /// sincronización, para no contar dos veces el mismo gasto.
  fuente       String   @default("MANUAL")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// En Postgres los nulos no colisionan en un índice único, así que las filas
  /// manuales (sin campaniaId) quedan libres y solo se deduplican las de API.
  @@unique([plataforma, campaniaId, desde])
  @@index([plataforma, desde, hasta])
  @@map("finanzas_inversion_publicitaria")
}

/// Precio oficial de un curso con su fecha de vigencia.
/// Para cambiar un precio se agrega una fila nueva, nunca se edita la anterior:
/// cada venta se compara contra el precio que regía el día en que ocurrió.
model PrecioOficial {
  id           String   @id @default(cuid())
  cursoId      String
  precio       Float
  vigenteDesde DateTime
  nota         String?
  createdAt    DateTime @default(now())
  curso        Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@unique([cursoId, vigenteDesde])
  @@index([cursoId, vigenteDesde])
  @@map("finanzas_precios_oficiales")
}

/// Parámetros editables del modelo (umbrales RFV, fecha de inicio, etc.).
/// Clave-valor para no migrar la base cada vez que aparece un umbral nuevo.
model ParametroFinanzas {
  clave       String   @id
  valor       String
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@map("finanzas_parametros")
}

/// Homologación de nombres de afiliado de Hotmart a un asesor.
/// Hotmart manda el nombre escrito como lo tenga el afiliado ("juan gomez",
/// "Luis alejandro"), y no siempre coincide con el correo del perfil. Sin esta
/// tabla esas ventas quedan sin atribución y no le suman a nadie.
model AliasAsesor {
  alias     String   @id
  asesorId  String
  createdAt DateTime @default(now())
  asesor    Asesor   @relation(fields: [asesorId], references: [id], onDelete: Cascade)

  @@index([asesorId])
  @@map("finanzas_alias_asesor")
}

// ── Redes sociales: cuentas vinculadas y publicaciones programadas ───────────

model RedSocialCuenta {
  id            String              @id @default(cuid())
  plataforma    RedSocialPlataforma
  nombre        String
  externalId    String // IG user id o Page id de Facebook
  accessToken   String // page access token de larga duración (nunca se expone al cliente)
  fotoUrl       String?
  activa        Boolean             @default(true)
  creadaEn      DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  publicaciones PublicacionRed[]

  @@unique([plataforma, externalId])
  @@map("redes_cuentas")
}

model PublicacionRed {
  id             String               @id @default(cuid())
  tipo           TipoPublicacionRed
  caption        String?
  mediaUrl       String? // Cloudinary; la Graph API la lee por URL pública
  mediaEsVideo   Boolean              @default(false)
  programadaPara DateTime
  estado         EstadoPublicacionRed @default(PROGRAMADA)
  error          String?
  externalId     String? // id del post/media ya publicado en la red
  publicadaEn    DateTime?
  creadaEn       DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  cuentaId       String
  cuenta         RedSocialCuenta      @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  creadaPorId    String?

  @@index([estado, programadaPara])
  @@map("redes_publicaciones")
}

enum RedSocialPlataforma {
  INSTAGRAM
  FACEBOOK
}

enum TipoPublicacionRed {
  POST
  HISTORIA
  REEL
}

enum EstadoPublicacionRed {
  PROGRAMADA
  PUBLICANDO
  PUBLICADA
  ERROR
  CANCELADA
}

// ── Contabilidad de Marketing (cuentas de cobro por quincena) ───────────────
// Migrado de la app pagosagencia.netlify.app (Supabase KV) a tablas propias.
// Flujo: el líder registra actividades de su equipo por quincena y la envía a
// contabilidad; contabilidad (ADMIN) aprueba/rechaza, marca pagado y exporta.

model ContabDepartamento {
  id        String          @id // slug: "marketing", "editores"…
  nombre    String
  gradiente String // "#1257C4,#8FD0FF" — baldosa del ícono
  icono     String // paths SVG (viewBox 24x24)
  esBase    Boolean         @default(false) // los 7 de fábrica no se borran
  orden     Int             @default(0)
  personas  ContabPersona[]
  envios    ContabEnvio[]
  tarifas   ContabTarifa[]

  @@map("contab_departamentos")
}

model ContabPersona {
  id        String             @id @default(cuid())
  deptId    String             @map("dept_id")
  slug      String // "sara-reyes"
  nombre    String
  cedula    String?
  rolTexto  String?            @map("rol_texto") // "Freelance", "Edición"…
  fotoUrl   String?            @map("foto_url") // URL o data-URI heredado
  activa    Boolean            @default(true)
  dept      ContabDepartamento @relation(fields: [deptId], references: [id], onDelete: Cascade)
  registros ContabRegistro[]

  @@unique([deptId, slug])
  @@map("contab_personas")
}

model ContabRegistro {
  id        BigInt        @id @default(autoincrement())
  personaId String        @map("persona_id")
  quincena  String // "2026-08-Q1"
  categoria String
  actividad String
  valor     Int // COP
  fecha     String // texto corto como el original: "14 de ago."
  link      String?
  imagenUrl String?       @map("imagen_url")
  revisado  Boolean       @default(false)
  aprobado  Boolean       @default(false)
  rechazado Boolean       @default(false)
  pagado    Boolean       @default(false)
  creadoAt  DateTime      @default(now()) @map("creado_at")
  persona   ContabPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@index([quincena])
  @@index([personaId, quincena])
  @@map("contab_registros")
}

model ContabEnvio {
  id        String             @id @default(cuid())
  deptId    String             @map("dept_id")
  quincena  String
  enviadoAt DateTime           @map("enviado_at")
  por       String // email de quien envió
  total     Int
  personas  Int
  dept      ContabDepartamento @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@unique([deptId, quincena])
  @@map("contab_envios")
}

model ContabTarifa {
  id     String              @id @default(cuid())
  deptId String?             @map("dept_id") // null = aplica a todos
  label  String
  valor  Int
  dept   ContabDepartamento? @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@map("contab_tarifas")
}

model ContabCategoria {
  id     String @id @default(cuid())
  nombre String @unique
  orden  Int    @default(0)

  @@map("contab_categorias")
}
